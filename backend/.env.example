# Optional -- every AI stage degrades to deterministic code without it.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash

# Neon Postgres in production. Unset locally -> SQLite file plumbline.db
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/plumbline?sslmode=require

# Signs login tokens. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Frontend origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# First admin/authority account (created or promoted at startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
